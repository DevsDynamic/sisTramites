APP_NAME="Sistema Trámites"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

# Propietario inicial. Obligatorio solo en la primera ejecución de db:seed.
SYSTEM_OWNER_EMAIL=admin@example.com
SYSTEM_OWNER_PASSWORD=

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sistramites
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# La aplicación no necesita Reverb para sus funciones actuales.
BROADCAST_CONNECTION=log

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Servicio interno PAdES. Se publica solo en 127.0.0.1 mediante Docker.
INTERNAL_SIGNER_URL=http://127.0.0.1:8088
INTERNAL_SIGNER_TOKEN=
INTERNAL_SIGNER_TIMEOUT=120

# Sello de tiempo Llama.pe. Déjalo vacío hasta recibir Ruta y Token de producción.
LLAMA_TIMESTAMP_ROUTE=
LLAMA_TIMESTAMP_TOKEN=
LLAMA_TIMESTAMP_TIMEOUT=120

VITE_APP_NAME="${APP_NAME}"
